# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#080203"

# Main text color
theme[main_fg]="#dde4f9"

# Title color for boxes
theme[title]="#dde4f9"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#93002b"

# Background color of selected item in processes box. #dde4f9 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #211b1c gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#211b1c"

# Foreground color of selected item in processes box. Use #dde4f9 so
# the row text stays readable on the lighter_bg highlight; the previous
# #93002b produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#dde4f9"

# Color of inactive/disabled text
theme[inactive_fg]="#f40026"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e2e8fa caps at #ffffff when the foreground is already pure white, so we
# just bind it to #dde4f9 directly.
theme[graph_text]="#dde4f9"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #dde4f9 collapsed to the main fg.
theme[meter_bg]="#211b1c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #00b791 for a distinct accent instead of #e2e8fa which capped to white.
theme[proc_misc]="#00b791"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#e34000"
theme[mem_box]="#5cab59"
theme[net_box]="#c65a4f"
theme[proc_box]="#93002b"

# Box divider line and small boxes line color
theme[div_line]="#f40026"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#5cab59"
theme[temp_mid]="#aaa72a"
theme[temp_end]="#c65a4f"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#00b791"
theme[cpu_mid]="#93002b"
theme[cpu_end]="#e34000"

# Mem/Disk free meter
theme[free_start]="#e34000"
theme[free_mid]="#93002b"
theme[free_end]="#00b791"

# Mem/Disk cached meter
theme[cached_start]="#93002b"
theme[cached_mid]="#00b791"
theme[cached_end]="#e34000"

# Mem/Disk available meter
theme[available_start]="#aaa72a"
theme[available_mid]="#c65a4f"
theme[available_end]="#c65a4f"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#5cab59"
theme[used_mid]="#00b791"
theme[used_end]="#93002b"

# Download graph colors
theme[download_start]="#aaa72a"
theme[download_mid]="#c65a4f"
theme[download_end]="#c65a4f"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#5cab59"
theme[upload_mid]="#00b791"
theme[upload_end]="#93002b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#00b791"
theme[process_mid]="#93002b"
theme[process_end]="#e34000"
